# ==============================================================================
# FamilyNest Environment Configuration Example
# Copy this file to .env and configure variables as needed.
# ==============================================================================

# Application
PROJECT_NAME=FamilyNest
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security / Authentication (JWT)
# Generate a secure secret key in production e.g. with `openssl rand -hex 32`
SECRET_KEY=replace_with_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Neon PostgreSQL Database Connection URL (Primary)
# Replace placeholder values with your Neon project connection parameters.
# SSL is required (sslmode=require).
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# CORS Origins (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
