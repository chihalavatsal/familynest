# ==============================================================================
# FamilyNest Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application
PROJECT_NAME=FamilyNest
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security / Authentication (JWT)
# Generate a secret key in production e.g. with `openssl rand -hex 32`
SECRET_KEY=familynest_development_secret_key_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Configuration (Local PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=familynest
POSTGRES_USER=familynest_user
POSTGRES_PASSWORD=familynest_dev_password

# Database Connection URL (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://familynest_user:familynest_dev_password@localhost:5432/familynest

# CORS Origins (comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
